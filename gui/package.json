{
  "name": "keeb-control",
  "version": "0.1.2",
  "private": true,
  "description": "Keeb Control — configure the ZUOYA GMK104 and compatible VIA keyboards + screen over hidraw (no flashing).",
  "author": "Hamza-b93",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "handshake": "node test-handshake.js",
    "upload": "node upload-image.js",
    "write-key": "node write-key.js",
    "set-light": "node set-light.js",
    "doctor": "node doctor.js",
    "game": "node game-screen.js",
    "widgets": "node screen-widgets.js",
    "test:screen": "node --test test-screen-codec.js",
    "test:image": "node --test test-image.js",
    "test:layout": "node --test test-layout.js",
    "test:game": "node --test test-game.js",
    "test:widgets": "node --test test-widgets.js",
    "test:lighting": "node --test test-lighting.js",
    "test:profiles": "node --test test-profiles.js",
    "test:macros": "node --test test-macros.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --linux AppImage",
    "dist:all": "electron-builder --linux AppImage snap flatpak"
  },
  "dependencies": {
    "node-hid": "^3.1.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.Hamza-b93.keeb_control",
    "productName": "Keeb Control",
    "artifactName": "keeb-control-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.cjs",
      "renderer/**",
      "src/**"
    ],
    "extraResources": [
      {
        "from": "../ZUOYA-GMK104-USB.json",
        "to": "ZUOYA-GMK104-USB.json"
      }
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "asarUnpack": [
      "**/*.node",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "linux": {
      "category": "Utility",
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "snap",
        "flatpak"
      ],
      "synopsis": "Configure ZUOYA GMK104 and compatible VIA keyboards over hidraw — no flashing.",
      "maintainer": "Hamza-b93"
    },
    "appImage": {
      "artifactName": "keeb-control-${version}-${arch}.${ext}"
    }
  }
}
