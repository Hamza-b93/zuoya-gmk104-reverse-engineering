/dts-v1/;

/*
 * ZUOYA GMK104 — Telink TLSR9511 (B91) — ZMK board skeleton  [DRAFT / UNVERIFIED]
 *
 * Generated from ZUOYA-GMK104-USB.json by tools/gen_board.py. This reuses the
 * Evision/B91 platform wiring proven on scholzri/rainy75-zmk (Apache-2.0). Build
 * it inside a fork of rainy75-zmk that provides the B91 drivers, open BLE
 * controller, telink HAL + patches, and the rainy_rgb engine.
 *
 *   VERIFIED  : matrix transform + physical layout (from the VIA definition),
 *               column GPIOs (Evision platform constant), all 8 ROW GPIOs
 *               (confirmed in the stock firmware disassembly), SoC/flash/USB/BLE.
 *   TODO/PROBE: the RGB chain-length, and the duplicated matrix cell RC(7,13)
 *               (see keymap). See BOARD-README.md.
 */

#include <freq.h>
#include <telink/telink_b91.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/led/led.h>
#include <physical_layouts.dtsi>

/ {
	model = "ZUOYA GMK104";
	compatible = "zuoya,gmk104";

	aliases { watchdog0 = &wdt0; };

	chosen {
		zephyr,sram = &ram_dlm;
		zephyr,flash = &flash;
		zephyr,flash-controller = &flash_mspi;
		zephyr,code-partition = &slot0_partition;
		zephyr,bt-hci = &bt_hci;
		zmk,battery = &battery;
		zmk,underglow = &led_strip;
		zmk,kscan = &kscan0;
		zmk,physical-layout = &gmk104_layout;
	};

	bt_hci: bt_hci { compatible = "telink,b91-bt-hci"; status = "okay"; };

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <14>;
		rows = <8>;
		/* physical order; RC(r,c) = electrical matrix cell from the VIA definition */
		map = <
			RC(7,13) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(7,0) RC(7,1) RC(5,4) RC(5,7)
			RC(5,6)
			RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(7,2) RC(7,3) RC(7,6) RC(6,0) RC(6,1) RC(6,2) RC(6,3)
			RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(7,4) RC(7,5) RC(7,7) RC(6,4) RC(6,5) RC(6,6) RC(6,10)
			RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,13) RC(6,7) RC(6,8) RC(6,9)
			RC(4,0) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,13) RC(7,8) RC(7,9) RC(6,11) RC(6,12) RC(7,13)
			RC(5,0) RC(5,1) RC(5,2) RC(5,5) RC(5,9) RC(5,10) RC(5,11) RC(5,12) RC(5,13) RC(7,10) RC(7,11) RC(6,13) RC(7,12)
		>;
	};

	gmk104_layout: gmk104_layout {
		compatible = "zmk,physical-layout";
		display-name = "ZUOYA GMK104";
		transform = <&default_transform>;

		keys  //                     w   h    x    y     rot    rx    ry
		    = <&key_physical_attrs  100  100     0     0       0     0     0>  /* RC(7,13) */
		    , <&key_physical_attrs  100  100   200     0       0     0     0>  /* RC(0,1) */
		    , <&key_physical_attrs  100  100   300     0       0     0     0>  /* RC(0,2) */
		    , <&key_physical_attrs  100  100   400     0       0     0     0>  /* RC(0,3) */
		    , <&key_physical_attrs  100  100   500     0       0     0     0>  /* RC(0,4) */
		    , <&key_physical_attrs  100  100   650     0       0     0     0>  /* RC(0,5) */
		    , <&key_physical_attrs  100  100   750     0       0     0     0>  /* RC(0,6) */
		    , <&key_physical_attrs  100  100   850     0       0     0     0>  /* RC(0,7) */
		    , <&key_physical_attrs  100  100   950     0       0     0     0>  /* RC(0,8) */
		    , <&key_physical_attrs  100  100  1100     0       0     0     0>  /* RC(0,9) */
		    , <&key_physical_attrs  100  100  1200     0       0     0     0>  /* RC(0,10) */
		    , <&key_physical_attrs  100  100  1300     0       0     0     0>  /* RC(0,11) */
		    , <&key_physical_attrs  100  100  1400     0       0     0     0>  /* RC(0,12) */
		    , <&key_physical_attrs  100  100  1550     0       0     0     0>  /* RC(0,13) */
		    , <&key_physical_attrs  100  100  1650     0       0     0     0>  /* RC(7,0) */
		    , <&key_physical_attrs  100  100  1750     0       0     0     0>  /* RC(7,1) */
		    , <&key_physical_attrs  100   50  1900     0       0     0     0>  /* RC(5,4) */
		    , <&key_physical_attrs  100  100  2100     0       0     0     0>  /* RC(5,7) */
		    , <&key_physical_attrs  100   50  1900    50       0     0     0>  /* RC(5,6) */
		    , <&key_physical_attrs  100  100     0   125       0     0     0>  /* RC(1,0) */
		    , <&key_physical_attrs  100  100   100   125       0     0     0>  /* RC(1,1) */
		    , <&key_physical_attrs  100  100   200   125       0     0     0>  /* RC(1,2) */
		    , <&key_physical_attrs  100  100   300   125       0     0     0>  /* RC(1,3) */
		    , <&key_physical_attrs  100  100   400   125       0     0     0>  /* RC(1,4) */
		    , <&key_physical_attrs  100  100   500   125       0     0     0>  /* RC(1,5) */
		    , <&key_physical_attrs  100  100   600   125       0     0     0>  /* RC(1,6) */
		    , <&key_physical_attrs  100  100   700   125       0     0     0>  /* RC(1,7) */
		    , <&key_physical_attrs  100  100   800   125       0     0     0>  /* RC(1,8) */
		    , <&key_physical_attrs  100  100   900   125       0     0     0>  /* RC(1,9) */
		    , <&key_physical_attrs  100  100  1000   125       0     0     0>  /* RC(1,10) */
		    , <&key_physical_attrs  100  100  1100   125       0     0     0>  /* RC(1,11) */
		    , <&key_physical_attrs  100  100  1200   125       0     0     0>  /* RC(1,12) */
		    , <&key_physical_attrs  200  100  1300   125       0     0     0>  /* RC(1,13) */
		    , <&key_physical_attrs  100  100  1550   125       0     0     0>  /* RC(7,2) */
		    , <&key_physical_attrs  100  100  1650   125       0     0     0>  /* RC(7,3) */
		    , <&key_physical_attrs  100  100  1750   125       0     0     0>  /* RC(7,6) */
		    , <&key_physical_attrs  100  100  1900   125       0     0     0>  /* RC(6,0) */
		    , <&key_physical_attrs  100  100  2000   125       0     0     0>  /* RC(6,1) */
		    , <&key_physical_attrs  100  100  2100   125       0     0     0>  /* RC(6,2) */
		    , <&key_physical_attrs  100  100  2200   125       0     0     0>  /* RC(6,3) */
		    , <&key_physical_attrs  150  100     0   225       0     0     0>  /* RC(2,0) */
		    , <&key_physical_attrs  100  100   150   225       0     0     0>  /* RC(2,1) */
		    , <&key_physical_attrs  100  100   250   225       0     0     0>  /* RC(2,2) */
		    , <&key_physical_attrs  100  100   350   225       0     0     0>  /* RC(2,3) */
		    , <&key_physical_attrs  100  100   450   225       0     0     0>  /* RC(2,4) */
		    , <&key_physical_attrs  100  100   550   225       0     0     0>  /* RC(2,5) */
		    , <&key_physical_attrs  100  100   650   225       0     0     0>  /* RC(2,6) */
		    , <&key_physical_attrs  100  100   750   225       0     0     0>  /* RC(2,7) */
		    , <&key_physical_attrs  100  100   850   225       0     0     0>  /* RC(2,8) */
		    , <&key_physical_attrs  100  100   950   225       0     0     0>  /* RC(2,9) */
		    , <&key_physical_attrs  100  100  1050   225       0     0     0>  /* RC(2,10) */
		    , <&key_physical_attrs  100  100  1150   225       0     0     0>  /* RC(2,11) */
		    , <&key_physical_attrs  100  100  1250   225       0     0     0>  /* RC(2,12) */
		    , <&key_physical_attrs  150  100  1350   225       0     0     0>  /* RC(2,13) */
		    , <&key_physical_attrs  100  100  1550   225       0     0     0>  /* RC(7,4) */
		    , <&key_physical_attrs  100  100  1650   225       0     0     0>  /* RC(7,5) */
		    , <&key_physical_attrs  100  100  1750   225       0     0     0>  /* RC(7,7) */
		    , <&key_physical_attrs  100  100  1900   225       0     0     0>  /* RC(6,4) */
		    , <&key_physical_attrs  100  100  2000   225       0     0     0>  /* RC(6,5) */
		    , <&key_physical_attrs  100  100  2100   225       0     0     0>  /* RC(6,6) */
		    , <&key_physical_attrs  100  200  2200   225       0     0     0>  /* RC(6,10) */
		    , <&key_physical_attrs  175  100     0   325       0     0     0>  /* RC(3,0) */
		    , <&key_physical_attrs  100  100   175   325       0     0     0>  /* RC(3,1) */
		    , <&key_physical_attrs  100  100   275   325       0     0     0>  /* RC(3,2) */
		    , <&key_physical_attrs  100  100   375   325       0     0     0>  /* RC(3,3) */
		    , <&key_physical_attrs  100  100   475   325       0     0     0>  /* RC(3,4) */
		    , <&key_physical_attrs  100  100   575   325       0     0     0>  /* RC(3,5) */
