		    , <&key_physical_attrs  100  100   975   325       0     0     0>  /* RC(3,9) */
		    , <&key_physical_attrs  100  100  1075   325       0     0     0>  /* RC(3,10) */
		    , <&key_physical_attrs  100  100  1175   325       0     0     0>  /* RC(3,11) */
		    , <&key_physical_attrs  225  100  1275   325       0     0     0>  /* RC(3,13) */
		    , <&key_physical_attrs  100  100  1900   325       0     0     0>  /* RC(6,7) */
		    , <&key_physical_attrs  100  100  2000   325       0     0     0>  /* RC(6,8) */
		    , <&key_physical_attrs  100  100  2100   325       0     0     0>  /* RC(6,9) */
		    , <&key_physical_attrs  225  100     0   425       0     0     0>  /* RC(4,0) */
		    , <&key_physical_attrs  100  100   225   425       0     0     0>  /* RC(4,2) */
		    , <&key_physical_attrs  100  100   325   425       0     0     0>  /* RC(4,3) */
		    , <&key_physical_attrs  100  100   425   425       0     0     0>  /* RC(4,4) */
		    , <&key_physical_attrs  100  100   525   425       0     0     0>  /* RC(4,5) */
		    , <&key_physical_attrs  100  100   625   425       0     0     0>  /* RC(4,6) */
		    , <&key_physical_attrs  100  100   725   425       0     0     0>  /* RC(4,7) */
		    , <&key_physical_attrs  100  100   825   425       0     0     0>  /* RC(4,8) */
